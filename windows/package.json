{
  "name": "cligriderator-windows",
  "productName": "Cli Griderator",
  "version": "4.3.0",
  "description": "Standalone Windows terminal grid",
  "author": "Kutty Stauder / Konatus Research Group",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.js",
    "test:ui": "playwright test",
    "test:runtime": "electron . --smoke-test",
    "check": "node scripts/check.mjs",
    "pack": "npm run build && electron-builder --win --x64 --dir",
    "dist": "npm run build && electron-builder --win nsis zip --x64 --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.konatus.cligriderator",
    "productName": "Cli Griderator",
    "directories": { "output": "out" },
    "files": ["src/**", "dist/**", "assets/**", "package.json", "LICENSE", "THIRD-PARTY-NOTICES.txt"],
    "asarUnpack": ["node_modules/node-pty/**"],
    "npmRebuild": true,
    "win": {
      "target": ["nsis", "zip"],
      "icon": "assets/icon.ico",
      "artifactName": "Cligriderator-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE",
      "artifactName": "Cligriderator-${version}-windows-${arch}-Setup.${ext}"
    }
  }
}
